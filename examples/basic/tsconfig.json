{
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2023",
		"lib": ["es2023", "dom", "dom.iterable"],
		"types": ["node"],
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"rootDir": "src",
		"outDir": "dist",
		"sourceMap": true
	},
	"include": ["src"]
}
