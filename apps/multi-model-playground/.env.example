# Local-only secrets. Never commit real values.
OPENAI_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me
GOOGLE_GENERATIVE_AI_API_KEY=replace-me

OPENAI_MODEL=gpt-5-mini
ANTHROPIC_MODEL=claude-haiku-4-5
GOOGLE_MODEL=gemini-2.5-flash

PORT=3001
DASHBOARD_ORIGIN=http://127.0.0.1:3000
PROVIDER_TIMEOUT_MS=45000
# Comparison-lab output budget.
MAX_OUTPUT_TOKENS=160

# Ignored local chat state, active-run limits, and ChatGPT-like output budget.
CHAT_STATE_DIR=.data
CHAT_RUN_TIMEOUT_MS=120000
CHAT_REPLAY_MAX_BYTES=4194304
CHAT_MAX_OUTPUT_TOKENS=2048
